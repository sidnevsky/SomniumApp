<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121858">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Назад"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/montserrat_bold"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/logo"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/logo"
            android:contentDescription="Логотип"
            android:scaleType="centerInside"/>
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginStart="35dp"
        android:layout_marginTop="60dp"
        android:text="Новая запись сна"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/montserrat_bold"/>

    <RelativeLayout
        android:id="@+id/textInputContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_below="@id/title"
        android:layout_marginStart="25dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="25dp"
        android:background="@drawable/round"
        android:padding="16dp">

        <EditText
            android:id="@+id/sleepNotes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Заметки о сне"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:gravity="top|start"
            android:background="@null"/>

        <ImageView
            android:id="@+id/micIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_micro"
            android:contentDescription="Микрофон"
            android:clickable="true"
            android:focusable="true"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/saveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/textInputContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="Сохранить"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="@font/montserrat_bold"
        android:clickable="true"
        android:focusable="true"/>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#000000"
        android:orientation="horizontal"
        android:weightSum="4"
        android:paddingHorizontal="8dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navHome"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Главная"
                android:scaleType="centerInside"
                android:src="@drawable/home123"/>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navAnalyze"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Анализ"
                android:scaleType="centerInside"
                android:src="@drawable/analyze123"/>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navSettings"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Настройки"
                android:scaleType="centerInside"
                android:src="@drawable/settings123"/>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navProfile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Профиль"
                android:scaleType="centerInside"
                android:src="@drawable/profile123"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>